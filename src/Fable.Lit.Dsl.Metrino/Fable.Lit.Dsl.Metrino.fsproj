<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.0.0</Version>
    <Authors>Jordan Marr</Authors>
    <Description>Metrino (Windows Phone / Windows 8 Metro design system) web component bindings for Fable.Lit.Dsl. Provides strongly-typed F# DSL elements for building Metro-style UIs with Fable.Lit.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/JordanMarr/Fable.Lit.Dsl</PackageProjectUrl>
    <RepositoryUrl>https://github.com/JordanMarr/Fable.Lit.Dsl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>fable;fsharp;lit;html;dsl;web-components;metrino;metro</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

  <!-- Add source files to "fable" folder in Nuget package -->
  <ItemGroup>
    <Content Include="*.fsproj; *.fs" PackagePath="fable\" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="MetrinoRegistration.fs" />
    <Compile Include="MetroRef.fs" />
    <Compile Include="MetrinoElements.fs" />
    <Compile Include="MetrinoAttrs.fs" />
    <Compile Include="MetrinoEvents.fs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Fable.Lit.Dsl\Fable.Lit.Dsl.fsproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Update="FSharp.Core" Version="6.0.4" />
  </ItemGroup>

</Project>
